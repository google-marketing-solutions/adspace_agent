# Gemini (Vertex AI with Application Default Credentials). ADC is only used for
# the model backend, Cloud Storage artifacts/skills and the Vertex sandbox; the
# Google data toolsets (BigQuery included) act with the signed-in user's OAuth
# token, so the service account needs no BigQuery/Ads/CM360 permissions.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Or use the Gemini Developer API instead of Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=

# Google API toolsets (OAuth 2.0 client of type "Web application").
# Add `${PUBLIC_BASE_URL}/oauth2/callback` to its authorized redirect URIs.
# While CLIENT_ID / CLIENT_SECRET are unset there is no Google Sign-In: the
# API, `/app/` and `/ui/` serve a single anonymous user to anyone who can
# reach the port (local development only). Once they are set, every API call
# requires a signed-in Google user and the stock `/ui/` dev UI is disabled.
CLIENT_ID=
CLIENT_SECRET=
# Public URL of this server, used to build the OAuth redirect URI. With an
# https:// URL the sign-in cookies are marked `Secure`.
PUBLIC_BASE_URL=http://localhost:8000
# Google accounts (comma-separated emails) allowed to switch the server-wide
# LLM / image / video models from the studio (`POST /auth/models`). With
# Sign-In configured and this unset, nobody can switch models at runtime.
# ADMIN_EMAILS=admin@example.com
# Extra secret mixed into the HMAC key that signs OAuth states and the sign-in
# cookie (derived from CLIENT_SECRET by default). Set it to keep cookies valid
# across instances/restarts when running without CLIENT_SECRET.
# OAUTH_STATE_SECRET=
# Seconds in-flight requests may finish after SIGTERM (Cloud Run allows 10).
# SHUTDOWN_GRACE_SECS=8

# Google Ads
# Reference:
# https://developers.google.com/google-ads/api/docs/api-policy/developer-token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optionals:
# MODEL=gemini-3.8-flash
# VIDEO_MODEL=veo-3.1-fast-generate-001
# IMAGE_MODEL=gemini-3.1-flash-image
# ENABLED_TOOLSETS=bid_manager,bigquery,campaign_manager_360,display_video_360,drive,merchant_center_inventories,merchant_center_products,merchant_center_reports,search_ads_360,storage,youtube,google_ads,google_genai
# GOOGLE_ADS_TOOL_FILTER=googleads_customers_google_ads_search,googleads_google_ads_fields_search,googleads_customers_generate_audience_definition,googleads_customers_generate_audience_composition_insights
# SKILLS_BUCKET_NAME=adspace-agent
# LOCAL_SKILLS_DIR=./skills

# Services (the equivalents of the `adk web --*_service_uri` flags)
# SESSION_SERVICE_URI=sqlite:///./sessions.db     # or firestore:// or memory://
# SESSION_ENCRYPTION_KEY=                         # optional base64 32-byte AES-256-GCM key for session state & OAuth tokens
# SESSION_ENCRYPTION_PREVIOUS_KEYS=               # optional comma-separated retired base64 keys for rotation
# ARTIFACT_SERVICE_URI=memory://                  # or gs://adspace-agent or file://./.artifacts
# MEMORY_SERVICE_URI=memory://

# Google OAuth tokens are stored in each chat session's state (key
# CREDENTIALS_CACHE_KEY) and persist with the session service; there is no
# server-side credential store.

# Gemini server-side tools: google_search,url_context,google_maps (default) | all (adds code_execution) | none
# GEMINI_BUILTIN_TOOLS=google_search,url_context,google_maps
# GOOGLE_MAPS_CONTEXT_LAT=41.8781   # optional default location for google_maps
# GOOGLE_MAPS_CONTEXT_LNG=-87.6298

# Python data-analysis backend: gemini (default, server-side) | docker | vertex | monty
# PYTHON_EXECUTOR=gemini
# PYTHON_DOCKER_IMAGE=python:3.15-slim
# VERTEX_SANDBOX_NAME=            # or VERTEX_AGENT_ENGINE=<reasoning engine id>

# Context caching / events compaction
# CONTEXT_CACHE_MIN_TOKENS=2048
# CONTEXT_CACHE_TTL_SECONDS=600
# CONTEXT_CACHE_INTERVALS=5
# COMPACTION_INTERVAL=3
# COMPACTION_OVERLAP_SIZE=1
# COMPACTION_TOKEN_THRESHOLD=500000
# COMPACTION_EVENT_RETENTION_SIZE=3

# Performance
# LAZY_TOOLSETS=campaign_manager_360,display_video_360,merchant_center_products   # none | all | list
# GOOGLE_API_SCHEMA_MAX_DEPTH=4                 # nesting depth of request schemas exposed to the model
# GOOGLE_API_SCHEMA_ENUM_DESCRIPTIONS=false     # verbose per-value enum descriptions
# GOOGLE_API_SCHEMA_NESTED_DESCRIPTIONS=true    # descriptions on nested request-body properties

# Advanced
# DISCOVERY_CACHE_DIR=off           # disable the on-disk Discovery document cache
# BIGQUERY_READ_ONLY=true           # false: allow DML and request the `bigquery` scope instead of `bigquery.readonly`
# RUST_LOG=info
